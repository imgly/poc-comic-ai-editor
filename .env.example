# Copy this file to .env.local and fill in the values.

# CE.SDK license key (required). Free trial: https://img.ly/forms/free-trial
NEXT_PUBLIC_CESDK_LICENSE=

# IMG.LY AI Gateway API key (https://img.ly/dashboard). Server-side only:
# /api/ai/token exchanges it for short-lived browser tokens.
# Empty: mock mode, generations are drawn locally so the workflow can still be clicked through.
IMGLY_AI_GATEWAY_API_KEY=

# Password for the whole site. Server-side only. Empty: no login screen.
SITE_PASSWORD=

# --- Optional ---

# Gateway base URL
IMGLY_AI_GATEWAY_URL=https://gateway.img.ly
# Text-to-image model preselected for backgrounds
NEXT_PUBLIC_IMGLY_AI_DEFAULT_IMAGE_MODEL=bfl/flux-2-pro
# Image-to-image model preselected for objects (must accept a prompt and a reference image)
NEXT_PUBLIC_IMGLY_AI_DEFAULT_EDIT_MODEL=google/nano-banana-2-edit
# Image-to-image model used by "Place object" (empty: the object model)
NEXT_PUBLIC_IMGLY_AI_PLACE_MODEL=
# UI language: de (default) or en
NEXT_PUBLIC_UI_LOCALE=de
